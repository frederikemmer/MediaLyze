{
  "name": "medialyze-desktop",
  "version": "0.19.1",
  "private": true,
  "license": "AGPL-3.0",
  "description": "Desktop packaging for the MediaLyze local media analysis app.",
  "author": "Frederik Emmer",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test ./ffprobe-paths.test.cjs ./update-download.test.cjs ./package.test.cjs ./scripts/build-backend.test.mjs ./scripts/smoke-test-backend.test.mjs",
    "generate:icons": "node ./scripts/generate-icons.mjs",
    "dist": "npm run generate:icons && electron-builder",
    "dist:dir": "npm run generate:icons && electron-builder --dir",
    "build:backend": "node ./scripts/build-backend.mjs"
  },
  "devDependencies": {
    "electron": "^41.10.6",
    "electron-builder": "^26.15.0",
    "ffmpeg-static": "5.3.0",
    "icon-gen": "^5.0.0"
  },
  "build": {
    "appId": "io.github.frederikemmer.medialyze",
    "productName": "MediaLyze",
    "directories": {
      "output": "../dist/desktop-app",
      "buildResources": ".generated-icons"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ffprobe-paths.cjs",
      "update-download.cjs"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../dist/desktop-backend",
        "to": "backend"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-arm64.${ext}",
      "icon": "medialyze.icns",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}.${ext}",
      "icon": "icon512.png",
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}.Setup.${ext}",
      "icon": "medialyze.ico"
    }
  },
  "overrides": {
    "fast-uri": "4.1.5",
    "@xmldom/xmldom": "0.8.15",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "tmp": "^0.2.7",
    "undici@^6": "^6.28.1",
    "undici@^7": "^7.29.1",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12"
  }
}
